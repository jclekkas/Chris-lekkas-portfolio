# Copy to .env.local for development. Never commit a filled-in copy.

# Absolute origin used for canonical URLs, hreflang, sitemap and social cards.
# Set this on preview deployments so they do not claim to be production.
NEXT_PUBLIC_SITE_URL=https://chrislekkas.com

# Contact delivery (server build only — the static export never reads these).
# Without RESEND_API_KEY the /api/contact route still validates and accepts a
# submission, logs it, and reports that it was not emailed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=jclekkas@gmail.com
CONTACT_FROM_EMAIL=Website <onboarding@resend.dev>

# Set automatically by `npm run build:static`. Do not set it by hand for a
# Vercel deployment — it turns the contact form into the email fallback.
# NEXT_PUBLIC_STATIC_EXPORT=1
